local petsMapa = {}

local function escanear()
    petsMapa = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and o.Parent then
            local p = o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart
            if p then
                local v = o:GetAttribute("Value") or o:GetAttribute("Earnings") or o:GetAttribute("Renda") or 0
                local fv = o:FindFirstChild("Value") or o:FindFirstChild("Earnings")
                if fv and fv:IsA("ValueBase") then v = fv.Value end
                local nl = o.Name:lower()
                local eOvo = nl:find("egg") or nl:find("ovo") or nl:find("pet") or nl:find("brainrot")
                if (tonumber(v) and tonumber(v) > 0) or eOvo then
                    local rar = "Common"
                    if nl:find("secret") then rar = "Secret"
                    elseif nl:find("divine") then rar = "Divine"
                    elseif nl:find("rare") or nl:find("mythic") then rar = "Rare" end
                    table.insert(petsMapa, {nome = o.Name, valor = tonumber(v) or 0, parte = p, rar = rar})
                end
            end
        end
    end
    table.sort(petsMapa, function(a, b) return a.valor > b.valor end)
end

