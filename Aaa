-- Movimento
local twAtual = nil

local function cancelar()
    if twAtual then pcall(function() twAtual:Cancel() end) twAtual = nil end
    local c = player.Character
    if c then
        local h = c:FindFirstChild("HumanoidRootPart")
        if h then
            h.Anchored = false
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function tp(dest)
    cancelar()
    local c = player.Character
    if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    h.Anchored = true
    h.AssemblyLinearVelocity = Vector3.zero
    h.AssemblyAngularVelocity = Vector3.zero
    h.CFrame = CFrame.new(dest.Position + Vector3.new(0, 6, 0))
    task.wait(0.05)
    h.Anchored = false
end

local function tw(dest, vel)
    cancelar()
    local c = player.Character
    if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local v = vel or cfg.velTween
    h.Anchored = true
    h.AssemblyLinearVelocity = Vector3.zero
    h.AssemblyAngularVelocity = Vector3.zero
    local d = (dest.Position - h.Position).Magnitude
    local dur = math.max(d / v, 0.1)
    local ti = TweenInfo.new(dur, Enum.EasingStyle.Linear)
    local tws = Tween:Create(h, ti, {CFrame = CFrame.new(dest.Position + Vector3.new(0, 6, 0))})
    twAtual = tws
    tws:Play()
    tws.Completed:Wait()
    if twAtual == tws then
        twAtual = nil
        h.Anchored = false
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end
end
